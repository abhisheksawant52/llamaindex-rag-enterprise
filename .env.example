# Application
LIRAG_APP_NAME=llamaindex-rag-enterprise
LIRAG_ENVIRONMENT=development
LIRAG_LOG_LEVEL=INFO

# OpenAI / models
LIRAG_OPENAI_API_KEY=your-key-here
LIRAG_EMBEDDING_MODEL=text-embedding-3-small
LIRAG_LLM_MODEL=gpt-4o-mini

# Vector store & retrieval
LIRAG_VECTOR_STORE_URL=http://localhost:6333
LIRAG_SIMILARITY_TOP_K=4
LIRAG_CHUNK_SIZE=1024
LIRAG_CHUNK_OVERLAP=128
